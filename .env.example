# Render Cloud PostgreSQL Connection URL (Primary)
DATABASE_URL=postgresql://USER:PASSWORD@dpg-xxxxx-a/DATABASE_NAME
# Note: For external database connections (e.g., running scripts from local machine), use the Render External Database URL with sslmode=require:
# DATABASE_URL=postgresql://USER:PASSWORD@dpg-xxxxx-a.oregon-postgres.render.com/DATABASE_NAME?sslmode=require

# Server & JWT Auth Configuration
PORT=5000
# IMPORTANT: Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_32_CHARS

# Production: add your domain(s) comma-separated
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# PR Coordinator Credentials
PR_ADMIN_USERNAME=pr_admin
PASS_PR_ADMIN=REPLACE_WITH_STRONG_PASSWORD

# Common Universal Password for All Logins
COMMON_PASSWORD="sems#2026"

# Unique Simple Passwords for College Heads (Username -> Password)
PASS_HEAD_MPEC="mpec#2026"
PASS_HEAD_MIPS="mips#2026"
PASS_HEAD_MPCPS="mpcps#2026"
PASS_HEAD_MPCP="mpcp#2026"
PASS_HEAD_MPDC="mpdc#2026"
PASS_HEAD_MPCNPS="mpcnps#2026"
PASS_HEAD_MPAMC="mpamc#2026"
PASS_HEAD_MPCAMS="mpcams#2026"

# Unique Simple Passwords for Sport Coordinators (Username -> Password)
PASS_COORD_CRICKET="cricket#2026"
PASS_COORD_TABLE_TENNIS="table_tennis#2026"
PASS_COORD_BADMINTON="badminton#2026"
PASS_COORD_CHESS="chess#2026"
PASS_COORD_FOOTBALL="football#2026"
PASS_COORD_BASKETBALL="basketball#2026"
PASS_COORD_VOLLEYBALL="volleyball#2026"
PASS_COORD_KABADDI="kabaddi#2026"
PASS_COORD_KHO_KHO="kho_kho#2026"
PASS_COORD_ATHLETICS="athletics#2026"
PASS_COORD_TUG_OF_WAR="tug_of_war#2026"
PASS_COORD_GULLY_CRICKET="gully_cricket#2026"

# React Frontend API Target URL
VITE_API_URL=http://localhost:5000/api
# NOTE: Do NOT put passwords in VITE_ variables — they are exposed in the browser bundle!
