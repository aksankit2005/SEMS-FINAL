# ============================================================
# SEMS PostgreSQL Database — CHOOSE ONE OPTION BELOW
# ============================================================

# ----------------------------------------------------------
# OPTION A: LOCAL PostgreSQL (after installing PostgreSQL)
# ----------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sems_db
PGHOST=localhost
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=sems_db
PGPORT=5432

# ----------------------------------------------------------
# OPTION B: Neon.tech (Free Online — replace with your URL)
# ----------------------------------------------------------
# DATABASE_URL=postgresql://username:password@ep-xxx.us-east-2.aws.neon.tech/sems_db?sslmode=require

# ----------------------------------------------------------
# OPTION C: Supabase (Free Online — replace with your URL)
# ----------------------------------------------------------
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxx.supabase.co:5432/postgres

